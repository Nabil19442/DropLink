PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
ROOM_TTL_MS=1800000
MAX_FILES_PER_TRANSFER=50
MAX_TOTAL_SIZE_BYTES=5368709120

