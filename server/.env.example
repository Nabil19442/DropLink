# ==============================================================
# DropLink Signaling Server Environment Variables (Render)
# ==============================================================

# Server Listening Port (automatically set by Render in production)
PORT=5000

# Environment Mode (production | development)
NODE_ENV=production

# Allowed Frontend Origins for CORS (Vercel URL)
# Supports comma-separated list of domains
# Example: https://droplink.vercel.app,https://yourcustomdomain.com
CLIENT_ORIGIN=https://droplink.vercel.app

# Automatically allow Vercel dynamic preview branch URLs (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# Temporary Room Time-To-Live in milliseconds (Default: 30 minutes)
ROOM_TTL_MS=1800000

# Maximum file count allowed per transfer batch
MAX_FILES_PER_TRANSFER=50

# Maximum total transfer batch size in bytes (Default: 5 GB)
MAX_TOTAL_SIZE_BYTES=5368709120

# ==============================================================
# WebRTC TURN Server Relay (Coturn on VPS)
# ==============================================================
# Optional: Required for symmetric NAT traversal, corporate firewalls, and CGNAT
# Comma-separated TURN URLs (UDP + TCP)
# Example: turn:YOUR_VPS_IP:3478?transport=udp,turn:YOUR_VPS_IP:3478?transport=tcp
TURN_SERVER_URL=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp
TURN_USERNAME=droplink_user
TURN_CREDENTIAL=your_secure_password_here
