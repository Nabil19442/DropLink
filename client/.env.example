# ==============================================================
# DropLink Frontend Environment Variables (Vercel)
# ==============================================================

# Backend Signaling Server URL (Render URL in production)
# Example: https://droplink-signaling.onrender.com
# In local development: leave empty to use the Vite local proxy (http://localhost:5000)
VITE_SERVER_URL=https://droplink-signaling.onrender.com

# Production App URL (Vercel Frontend URL)
# Used for generating absolute QR codes and shareable room links
# Example: https://droplink.vercel.app
# If omitted, defaults to window.location.origin
VITE_APP_URL=https://droplink.vercel.app
